# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# 博客管理
# 注意：ADMIN_SECRET 目前是 vestigial 配置，代码中 verifyAdminSecret() 无引用。
# /admin 现在纯靠 Supabase session 鉴权。保留仅为兼容旧部署。
# ============================================================
ADMIN_SECRET=your-long-secret

# ============================================================
# 站点
# ============================================================
NEXT_PUBLIC_SITE_URL=

# ============================================================
# AI 对话 —— 模型注册表见 ai-models.json
# 每个模型在 ai-models.json 里声明 apiKeyEnv / baseUrlEnv，
# 代码按声明的 env 变量名读取。加新 provider 只需：
#   1. ai-models.json 加模型条目（指定 apiKeyEnv / baseUrlEnv）
#   2. .env.local 设置对应的 env 变量
# 不需要改任何代码。
# ============================================================

# —— Google Gemini（provider: "google"）——
GOOGLE_GENERATIVE_AI_API_KEY=

# —— OpenAI 官方（provider: "openai"）——
OPENAI_API_KEY=
OPENAI_BASE_URL=

# —— Anthropic Claude（provider: "anthropic"）——
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# —— DeepSeek（provider: "openai"，OpenAI 兼容端点）——
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# —— 智谱 GLM（provider: "openai"，OpenAI 兼容端点）——
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ============================================================
# Upstash Redis（短期记忆摘要缓存 / 分布式速率限制）
# 未配置时，AI 对话的短期记忆退化为纯滑窗截断（不摘要）。
# 在 https://upstash.com 创建 Redis 数据库后填入以下两项。
# ============================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=