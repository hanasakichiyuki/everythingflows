# 万物流转 · systemd 服务单元
#
# 安装：
#   sudo cp deploy/systemd/flows.service /etc/systemd/system/flows.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now flows
#
# 说明（2 核 2G 专用调参）：
#   - HOSTNAME 必须显式设为 127.0.0.1。Next standalone 的 server.js 会读
#     process.env.HOSTNAME 作为监听地址；若被系统设置成机器名，可能绑定到公网网卡，
#     绕过 Nginx 暴露出去。这里锁死在回环地址，只允许 Nginx 回源。
#   - NODE_OPTIONS 限制 V8 堆；MemoryHigh/MemoryMax 限制整个 cgroup 的 RSS。
#     三层护栏叠加，保证一个 Next 进程不会把 2G 机器拖垮。

[Unit]
Description=Everything Flows (Next.js standalone)
Documentation=https://github.com/hanasakichiyuki/everythingflows
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy

WorkingDirectory=/srv/everythingflows/current

# 运行期环境变量。文件权限必须是 600、属主 deploy。
EnvironmentFile=/etc/everythingflows/env.production

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=NODE_OPTIONS=--max-old-space-size=640

ExecStart=/usr/bin/node server.js

Restart=always
RestartSec=3

# 优雅退出：Next 需要时间收尾正在进行的请求与流式响应
KillSignal=SIGTERM
TimeoutStopSec=20

# ---- 内存护栏（2G 机器）----
# 堆上限看 NODE_OPTIONS，RSS 上限看这两行。
# MemoryHigh 是软上限，超了内核开始压制回收，不会杀进程；
# MemoryMax 是硬上限，超了 SIGKILL，配合 Restart=always 自愈。
# 若日志里出现反复重启，说明业务确实吃紧，升配 2 核 4G 比继续压参数划算。
MemoryHigh=800M
MemoryMax=1200M

# ---- 加固 ----
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# ISR 再生成会写 .next/cache，这里必须给写权限，否则报 EROFS
ReadWritePaths=/srv/everythingflows/current

LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
