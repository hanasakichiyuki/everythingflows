# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results/
/playwright-report/
/e2e/visual.spec.ts-snapshots/*-chromium-win32.png

# next.js
/.next/
# 所有验证用 distDir（NEXT_DIST_DIR 可指向任意 .next-* 目录）
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 编辑器/工具的项目级本地状态（CodeBuddy 会在工作区写 .codebuddy/）
.codebuddy/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# 自托管部署的环境变量（含 service role / Upstash / R2 / AI 密钥）
# 实际放在服务器的 /etc/everythingflows/env.production，这里防止误提交
.env.production
.env.production.*
.env*.production

# vercel
.vercel

# 本地 AI 助手的工作区记忆，不属于项目源码
.workbuddy/

# typescript
*.tsbuildinfo
next-env.d.ts
debug.log
dev-server-error.log
dev-server.log
